---
/**
 * One incident as a card in a list (homepage active list, history
 * day group). Title + status pill + severity badge in the header
 * row, lede body underneath, started/resolved meta line at the
 * bottom.
 *
 * The whole card is a link to /incidents/[id]. We can't use an
 * Astro component for the client-side renders that the polling
 * loop does — those are emitted as inline HTML in index.astro.
 * This component is the SERVER-SIDE rendering for any
 * pre-rendered card (none today, but we keep the shape so that
 * marking up the same incident in JS produces visually
 * identical output).
 */
import SeverityBadge from './SeverityBadge.astro';
import type { IncidentView } from '../lib/api';
import { statusLabel } from '../lib/severity';
import { relativeTime } from '../lib/time';

export interface Props {
  incident: IncidentView;
}
const { incident } = Astro.props;
const startedRel = relativeTime(incident.startedAt);
const resolvedRel = incident.resolvedAt
  ? relativeTime(incident.resolvedAt)
  : null;
---
<a class="incident-card" href={`/incidents/${incident.id}`}>
  <div class="incident-card__head">
    <h3 class="incident-card__title">{incident.title}</h3>
    <span class="stat" data-stat={incident.status}>
      <span class="stat__dot"></span>
      {statusLabel(incident.status)}
    </span>
    <SeverityBadge severity={incident.severity} />
  </div>
  {incident.body && (
    <p class="incident-card__body">{incident.body}</p>
  )}
  <div class="incident-card__meta">
    <span>Started <time datetime={incident.startedAt}>{startedRel}</time></span>
    {resolvedRel && (
      <span>Resolved <time datetime={incident.resolvedAt!}>{resolvedRel}</time></span>
    )}
    {incident.updates.length > 0 && (
      <span>{incident.updates.length} update{incident.updates.length === 1 ? '' : 's'}</span>
    )}
  </div>
</a>
