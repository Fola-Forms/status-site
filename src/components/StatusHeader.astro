---
/**
 * The big status banner at the top of the homepage. Renders with
 * a neutral "Checking…" state at build time and hydrates to the
 * real state from the polling loop in index.astro.
 *
 * Markup is structured so the client script (in index.astro) can
 * cheaply update individual nodes without re-rendering the whole
 * banner: the title, sub-line, and last-checked stamp each have
 * stable IDs. There is no "offline" chip — the "Last checked X ago"
 * stamp is enough signal; if the API genuinely vanishes the stamp
 * drifts forward and the user can see the data is stale.
 */
---
<section class="status-banner"
         id="status-banner"
         data-state="unknown"
         aria-live="polite">
  <div class="shell status-banner__inner">
    <div class="status-banner__icon" id="status-banner-icon" aria-hidden="true">
      <!-- Spinner during the initial fetch. The client script
           swaps this to a check / warning / wrench depending on
           resolved state. -->
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2.2" stroke-linecap="round"
           stroke-linejoin="round">
        <circle cx="12" cy="12" r="9" opacity="0.35"/>
        <path d="M21 12a9 9 0 0 0-9-9">
          <animateTransform attributeName="transform"
                            type="rotate"
                            from="0 12 12"
                            to="360 12 12"
                            dur="1.1s"
                            repeatCount="indefinite"/>
        </path>
      </svg>
    </div>
    <div class="status-banner__body">
      <h1 class="status-banner__title" id="status-banner-title">
        Checking status&hellip;
      </h1>
      <p class="status-banner__sub">
        <span id="status-banner-sub">
          Loading the latest from api.folaform.com.
        </span>
        <span class="status-banner__chip" id="status-banner-stamp">
          <span class="status-banner__chip-dot" aria-hidden="true"></span>
          <span id="status-banner-stamp-text">Last checked: just now</span>
        </span>
      </p>
    </div>
  </div>
</section>
